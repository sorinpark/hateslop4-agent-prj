# LLM: Gemini 2.5-flash-lite (발표 데모용)
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
# Postgres(Supabase) 연결 문자열. Supabase 대시보드 > Connect > URI(Transaction pooler 권장)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xxxx.pooler.supabase.com:6543/postgres
DATA_DIR=../data
POSE_MODEL_PATH=../data/pose_landmarker.task
# 로컬 개발은 비워둬도 됨(localhost:5173/사설 IP/cloudflared는 자동 허용).
# 배포 시에는 실제 프론트 도메인으로 채우기(콤마로 여러 개 가능): https://myapp.vercel.app
FRONTEND_ORIGIN=
# 배포 서버에서는 반드시 production으로 설정 - 안 하면 위 로컬 개발용 CORS 허용 규칙이 그대로 열려있음
ENVIRONMENT=development